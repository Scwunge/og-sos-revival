# Copy to deploy/classic-backend/host.env (chmod 600, never commit). One hosted session from OGSOS_CLASSIC_HOSTS.
OGSOS_BACKEND=203.0.113.10:7781
SESSION_ID=
SESSION_TOKEN=
HOST_ID=0
# Hour (UTC) for the daily restart that renews the 24 h host token.
RESTART_HOUR=9

# Optional: map to launch (default LaCuna). A full path works, e.g. /Game/Maps/Test_Mike/Layouts/Circle01
#GAME_MAP=LaCuna
