# Copy to server.env and edit. Used by docker compose (env_file).

# Name shown in the server list (3 to 48 characters). Do not imitate official servers.
NAME=My SOS Server
REGION=EU
MAX_PLAYERS=16

# The UDP port you forward on your router to this machine. Announced to the backend.
# compose publishes it on the same number (the game itself always listens on 7777 inside the container).
PUBLIC_PORT=7777

# Lobby backend, host:port.
BACKEND=sos.joltora.com:7781

# Optional: community key from the backend admin (makes your server verified).
COMMUNITY_KEY=
