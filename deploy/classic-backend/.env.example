# Copy to .env next to compose.yaml, chmod 600, fill in. Never commit .env: it holds the session token.

# Address the container's port 7781 is published on (the server's public IPv4; 0.0.0.0 = all).
BIND_IP=0.0.0.0

# IPv4 that clients are told to connect to for the game (UDP 7777). The client does no DNS.
OGSOS_CLASSIC_PUBLIC_HOST=203.0.113.5

# Public IPv4:port of THIS backend as listed in GET /servers (what a server browser connects to).
# Leave unset to use <OGSOS_CLASSIC_PUBLIC_HOST>:<listening port>.
#OGSOS_PUBLIC_BACKEND=203.0.113.5:7781

# The fixed hosted session (optional "name" max 48 and "region" max 16 chars show up in GET /servers). Make the values with:
#   node -e "console.log(crypto.randomUUID(), require('crypto').randomBytes(24).toString('hex'))"
# hostIds: the SteamID64 of whoever runs the game host (tools/host_classic.js --backend ...).
# "host" is what the game host sees for itself; clients get OGSOS_CLASSIC_PUBLIC_HOST.
OGSOS_CLASSIC_HOSTS='[{"host":"127.0.0.1","port":7777,"sessionId":"<uuid>","sessionToken":"<secret>","hostIds":["<SteamID64>"]}]'

# Players needed before the countdown, and the countdown in seconds.
OGSOS_CLASSIC_START_MIN_PLAYERS=2
OGSOS_CLASSIC_START_COUNTDOWN_SECONDS=10
