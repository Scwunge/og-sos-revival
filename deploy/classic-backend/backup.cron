# /etc/cron.d/ogsos-backup: nightly backend state backup at 04:17 UTC, 14 days kept (deploy/classic-backend/backup.sh).
# Install: cp backup.sh /usr/local/sbin/ogsos-backup && chmod 700 /usr/local/sbin/ogsos-backup && cp backup.cron /etc/cron.d/ogsos-backup
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
17 4 * * * root /usr/local/sbin/ogsos-backup >> /var/log/ogsos-backup.log 2>&1
